rules_version = '2';

// Rogue District Co. — Firestore security rules
//
// WHY THIS FILE MATTERS: admin.html / worker.html / roguestore.html only check
// ADMIN_EMAILS / WORKER_EMAILS / CONFIG.adminEmails in the browser. That check
// decides what buttons render — it does NOT stop anyone who opens dev tools
// (or writes 10 lines of JS with your public firebaseConfig) from calling
// Firestore directly and reading or editing anything, unless rules like these
// are deployed. Without this file, the whole admin/staff split is decorative.
//
// Deploy with: firebase deploy --only firestore:rules

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/admins/$(request.auth.uid));
}

function isStaff() {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/staff/$(request.auth.uid));
}

function isAdminOrStaff() {
  return isAdmin() || isStaff();
}

// Fields staff are allowed to touch on an order: status + trackingHistory only.
// Everything else (total, cancelledAt, extensions, customer, items, payment...)
// must be unchanged for a staff-authored write to be accepted.
function onlyStatusFieldsChanged() {
  let allowed = ['status', 'trackingHistory'];
  return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
}

// Staff can move an order forward (processing/shipped/delivered) but can
// never set it to 'cancelled' — that stays admin-only.
function staffStatusIsAllowed() {
  return request.resource.data.status != 'cancelled';
}

match /databases/{database}/documents {

  // ---------- ADMIN / STAFF ROSTERS ----------
  // Written only by bootstrap.html (once, self-locking) and worker-bootstrap.html
  // (gated behind an admin sign-in). No client write path should ever hit these
  // directly, so lock both collections to admin-only, server-side.
  match /admins/{uid} {
    allow read: if isAdmin();
    allow write: if false; // created via Firebase Auth Admin SDK / bootstrap flow only
  }
  match /staff/{uid} {
    allow read: if isAdmin();
    allow write: if isAdmin(); // covers worker-bootstrap.html's setDoc while signed in as admin
  }
  match /system/{docId} {
    allow read: if isAdmin();
    allow write: if false; // adminBootstrap lock doc — set only during the one-time bootstrap
  }

  // ---------- ORDERS ----------
  match /orders/{orderId} {
    // Customers may read their own orders; admin/staff may read all.
    allow read: if isAdminOrStaff() ||
      (isSignedIn() && resource.data.userId == request.auth.uid);

    // Customers create their own order at checkout.
    allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

    // Admin can update anything (status, cancellation, delivery extensions, etc).
    allow update: if isAdmin();

    // Staff can only advance status/trackingHistory, and can never cancel.
    allow update: if isStaff() && onlyStatusFieldsChanged() && staffStatusIsAllowed();

    allow delete: if isAdmin();
  }

  // ---------- PRODUCTS ----------
  // Once products move out of the hardcoded PRODUCTS array in roguestore.html
  // and into this collection, use something like:
  match /products/{productId} {
    allow read: if true; // public storefront needs to read products
    allow create, delete: if isAdmin();               // only admin adds/removes products
    allow update: if isAdmin() ||
      (isStaff() && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['price', 'stock', 'description', 'status']));
    // ^ staff can reprice/restock/edit description, not touch name/images/category etc.
    // Adjust the allowed field list to whatever you actually want staff to edit.
  }

  // ---------- EVERYTHING ELSE ----------
  // Default-deny anything not explicitly matched above.
  match /{document=**} {
    allow read, write: if false;
  }
}
